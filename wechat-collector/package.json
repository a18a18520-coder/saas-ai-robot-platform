{
  "name": "wechat-collector",
  "productName": "微信信息采集助手",
  "version": "0.6.0",
  "description": "Local-first, reviewed WeChat window text collection for macOS and Windows",
  "private": true,
  "license": "LicenseRef-Noncommercial-Commercial-Permission",
  "author": {
    "email": "250979539@qq.com"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run resources && electron .",
    "test": "node --test test/*.test.cjs",
    "test:native": "node scripts/native-test.cjs",
    "check:native": "node scripts/native-verify.cjs",
    "resources": "node scripts/resources.cjs && node scripts/native.cjs",
    "resources:win": "node scripts/resources.cjs && node scripts/native.cjs --win",
    "check": "node scripts/check.cjs",
    "preview": "node scripts/preview.cjs",
    "smoke:desktop": "npm run resources && electron . --smoke-check",
    "smoke:ocr": "npm run resources && node scripts/ocr-smoke.cjs",
    "smoke:native": "node scripts/native-smoke.cjs",
    "test:platform": "node scripts/platform-contract.cjs",
    "test:tenant-sync": "node scripts/tenant-sync-contract.cjs",
    "test:tenant-postgres": "node scripts/tenant-sync-postgres.cjs",
    "build:mac": "npm run resources && electron-builder --mac --publish never",
    "build:win": "npm run resources:win && electron-builder --win --publish never",
    "build:win:installer": "npm run resources:win && electron-builder --win nsis --x64 --publish never",
    "build:dir": "npm run resources && electron-builder --dir --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "build": {
    "appId": "local.wechat.collector",
    "beforePack": "./scripts/native-verify.cjs",
    "productName": "WeChat Collector",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "src/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/ocr",
        "to": "ocr"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extraResources": [
        {
          "from": "resources/native",
          "to": "native",
          "filter": [
            "wechat-control-arm64",
            "wechat-control-x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/native",
          "to": "native",
          "filter": [
            "wechat-control.exe",
            "windows-build.json",
            "licenses/**"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false
    },
    "publish": null
  }
}
