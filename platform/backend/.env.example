# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=robot
DB_PASS=robot
DB_NAME=robot_platform
DB_SYNC=false         # 默认禁用自动改表；仅临时本地库可显式设为 true
DB_MIGRATIONS_RUN=false # 建议发布流水线单独执行 npm run migration:run

# ===== 服务安全 =====
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5175
TRUST_PROXY_HOPS=0              # 经过可信反向代理时设为代理跳数；不得盲目信任 X-Forwarded-For
APP_ENCRYPTION_KEY=              # 必填（32 字节 Base64）：openssl rand -base64 32
APP_ENCRYPTION_KEY_PREVIOUS=     # 轮换期间可选，格式同上

# ===== Redis（BullMQ 异步队列/幂等）=====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET= # 必填：自行生成随机值，不使用公开示例密码

# ===== Dify（自建私有化，ADR-002）=====
DIFY_BASE_URL=http://dify.internal:3001
DIFY_SERVICE_API_KEY=            # 平台服务账号（知识同步写路径）
DIFY_ADMIN_API_KEY=              # 平台管理员 Key（ds-key 创建/资源同步）

# ===== 平台内置超级管理员（启动时幂等写入数据库）=====
PLATFORM_SUPER_ADMIN_EMAIL=admin@platform.local
PLATFORM_SUPER_ADMIN_PASSWORD= # 必填：首次启动前自行设置强密码
PLATFORM_TOTP_SECRET=                 # 可选 Base32 密钥；配置后内置超管必须使用 MFA

# ===== 企业 OIDC SSO（可选；配置完整后租户登录页自动启用）=====
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/v1/platform/auth/tenant/sso/callback
OIDC_SCOPE=openid email profile
OIDC_REQUIRE_EMAIL_VERIFIED=true
PUBLIC_APP_URL=http://localhost:5175

# ===== SMTP 激活邮件 =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Robot Platform <no-reply@example.com>
SMTP_HELO_NAME=saas-ai-robot-platform

# ===== 微信支付 API v3 Native =====
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY=            # PEM，可使用 \n 表示换行
WECHAT_PAY_API_V3_KEY=             # 32 字节
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=    # PEM，可使用 \n 表示换行
WECHAT_PAY_NOTIFY_URL=https://example.com/api/v1/public/payments/wechat/notify

# ===== 支付宝当面付（预创建）=====
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=                  # 可选；配置后回调必须匹配该收款账号
ALIPAY_APP_PRIVATE_KEY=            # PEM，可使用 \n 表示换行
ALIPAY_PUBLIC_KEY=                 # 支付宝公钥 PEM
ALIPAY_NOTIFY_URL=https://example.com/api/v1/public/payments/alipay/notify

# ===== 对公转账收款账户 =====
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NO=
BANK_NAME=
