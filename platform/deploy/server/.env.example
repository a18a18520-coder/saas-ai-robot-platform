# Copy to .env and chmod 600. Never reuse development credentials.
APP_DOMAIN=ai.example.com
ACME_EMAIL=ops@example.com
RELEASE_TAG=2026-10-08-01
BACKEND_TARGET=runtime
DB_USER=robot
DB_NAME=robot_platform
DB_PASS=
JWT_SECRET=
APP_ENCRYPTION_KEY=
PLATFORM_SUPER_ADMIN_EMAIL=admin@example.com
PLATFORM_SUPER_ADMIN_PASSWORD=
# Optional: platform models, channels and tool credentials are configured in UI.
# HTTPS or private-network Dify address reachable FROM the backend container.
DIFY_BASE_URL=https://dify.example.com
DIFY_SERVICE_API_KEY=
DIFY_ADMIN_API_KEY=
# Add SMTP / SSO / payment settings from backend/.env.example when used.
# Set BACKEND_TARGET=ragas and rebuild to enable the Python evaluation runtime.
